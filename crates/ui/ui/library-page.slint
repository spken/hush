import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Library } from "library.slint";
import { Nav } from "catalog.slint";
import { Icons } from "components/icon.slint";
import { PillButton } from "components/pill-button.slint";
import { ListEntry } from "components/list-entry.slint";
import { PosterHeader } from "components/poster-header.slint";
import { SongRow } from "components/song-row.slint";

// The library: Liked Songs, the saved albums and the playlists on the left, the open
// one's songs or albums beside them, set under a poster header.
export component LibraryPage inherits VerticalLayout {
    padding-top: Theme.space-6;
    padding-left: Theme.space-7;
    padding-right: Theme.space-7;
    spacing: Theme.space-5;

    HorizontalLayout {
        height: Theme.pill-height;
        spacing: Theme.space-4;

        Text {
            text: "Library";
            vertical-alignment: center;
            font-family: Theme.font-display;
            font-size: Theme.text-title;
            font-weight: Theme.weight-bold;
            letter-spacing: Theme.tracking-display;
            color: Theme.text;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if Library.syncing: Text {
            text: Library.sync-status;
            vertical-alignment: center;
            font-size: Theme.text-small;
            color: Theme.text-secondary;
        }

        if !Library.syncing: PillButton {
            icon: Icons.sync;
            text: "Sync Now";
            clicked => { Library.sync(); }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: Theme.space-7;

        VerticalLayout {
            width: Theme.sidebar-width;

            ListEntry {
                title: "Liked Songs";
                detail: Library.liked-detail;
                glyph: Icons.heart;
                selected: Library.open-key == 0;
                clicked => { Library.open(0); }
            }

            ListEntry {
                title: "Albums";
                detail: Library.albums-detail;
                glyph: Icons.album;
                selected: Library.open-key == -1;
                clicked => { Library.open(-1); }
            }

            ListView {
                for playlist in Library.playlists: ListEntry {
                    title: playlist.name;
                    detail: playlist.detail;
                    selected: playlist.key == Library.open-key;
                    clicked => { Library.open(playlist.key); }
                }
            }
        }

        VerticalLayout {
            spacing: Theme.space-5;

            PosterHeader {
                glyph: Library.open-key == 0 ? Icons.heart : Library.open-key == -1 ? Icons.album : Icons.note;
                title: Library.open-title;
                detail: Library.open-detail;
                playable: Library.open-key != -1 && Library.tracks.length > 0;
                play(shuffle) => { Library.play(Library.open-key, 0, shuffle); }
            }

            if Library.open-key == -1 ? Library.albums.length == 0 : Library.tracks.length == 0: Text {
                text: Library.open-empty;
                wrap: word-wrap;
                font-size: Theme.text-body;
                color: Theme.text-secondary;
            }

            if Library.open-key == -1: ListView {
                vertical-stretch: 1;
                for album in Library.albums: ListEntry {
                    title: album.name;
                    detail: album.year == "" ? album.artists : album.artists + " · " + album.year;
                    glyph: Icons.album;
                    clicked => { Nav.open-album(album.key); }
                }
            }

            if Library.open-key != -1: ListView {
                // A newly opened list starts at its top.
                property <int> open-key: Library.open-key;
                changed open-key => { self.content-y = 0; }

                vertical-stretch: 1;
                for track in Library.tracks: SongRow {
                    track: track;
                    play => { Library.play(Library.open-key, track.key, false); }
                    open-artist(key) => { Nav.open-artist(key); }
                }
            }
        }
    }
}
