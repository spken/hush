import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Library } from "library.slint";
import { Nav } from "catalog.slint";
import { Icons } from "components/icon.slint";
import { PillButton } from "components/pill-button.slint";
import { ListEntry } from "components/list-entry.slint";
import { MenuButton } from "components/menu-button.slint";
import { PosterHeader } from "components/poster-header.slint";
import { SongRow } from "components/song-row.slint";

// The library: Liked Songs and the playlists, pinned ones first, on the left; the open
// one's songs beside them, set under a poster header.
export component LibraryPage inherits VerticalLayout {
    padding-top: Theme.space-6;
    padding-left: Theme.space-7;
    padding-right: Theme.space-7;
    spacing: Theme.space-5;

    HorizontalLayout {
        height: Theme.pill-height;
        spacing: Theme.space-4;

        Text {
            text: "Library";
            vertical-alignment: center;
            font-family: Theme.font-display;
            font-size: Theme.text-title;
            font-weight: Theme.weight-bold;
            letter-spacing: Theme.tracking-display;
            color: Theme.text;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if Library.syncing: Text {
            text: Library.sync-status;
            vertical-alignment: center;
            font-size: Theme.text-small;
            color: Theme.text-secondary;
        }

        if !Library.syncing: PillButton {
            icon: Icons.sync;
            text: "Sync Now";
            clicked => { Library.sync(); }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: Theme.space-7;

        VerticalLayout {
            width: Theme.sidebar-width;

            ListEntry {
                title: "Liked Songs";
                detail: Library.liked-detail;
                glyph: Icons.heart;
                selected: Library.open-key == 0;
                clicked => { Library.open(0); }
            }

            HorizontalLayout {
                padding-top: Theme.space-4;
                padding-left: Theme.space-2;
                padding-bottom: Theme.space-1;

                Text {
                    horizontal-stretch: 1;
                    text: "Playlists";
                    vertical-alignment: center;
                    font-size: Theme.text-caption;
                    font-weight: Theme.weight-semibold;
                    letter-spacing: Theme.tracking-label;
                    color: Theme.text-secondary;
                }

                MenuButton {
                    label: "Sort playlists";
                    options: Library.orders;
                    current: Library.order;
                    chosen(index) => { Library.sort(index); }
                }
            }

            ListView {
                for playlist[index] in Library.playlists: ListEntry {
                    title: playlist.name;
                    detail: playlist.detail;
                    art: playlist.art;
                    selected: playlist.key == Library.open-key;
                    pinnable: true;
                    pinned: index < Library.pinned-count;
                    clicked => { Library.open(playlist.key); }
                    pin(pinned) => { Library.pin(playlist.key, pinned); }
                }
            }
        }

        VerticalLayout {
            spacing: Theme.space-5;

            PosterHeader {
                glyph: Library.open-key == 0 ? Icons.heart : Icons.note;
                art: Library.open-art;
                title: Library.open-title;
                detail: Library.open-detail;
                playable: Library.tracks.length > 0;
                play(shuffle) => { Library.play(Library.open-key, 0, shuffle); }
            }

            if Library.tracks.length == 0: Text {
                text: Library.open-empty;
                wrap: word-wrap;
                font-size: Theme.text-body;
                color: Theme.text-secondary;
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: Theme.space-1;

                if Library.tracks.length > 0: HorizontalLayout {
                    padding-left: Theme.space-2;

                    Text {
                        horizontal-stretch: 1;
                        text: "Songs";
                        vertical-alignment: center;
                        font-size: Theme.text-caption;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: Theme.tracking-label;
                        color: Theme.text-secondary;
                    }

                    MenuButton {
                        label: "Sort songs";
                        options: Library.track-orders;
                        current: Library.track-order;
                        chosen(index) => { Library.sort-tracks(index); }
                    }
                }

                ListView {
                    // A newly opened or reordered list starts at its top.
                    property <int> open-key: Library.open-key;
                    property <int> track-order: Library.track-order;
                    changed open-key => { self.content-y = 0; }
                    changed track-order => { self.content-y = 0; }

                    vertical-stretch: 1;
                    for track in Library.tracks: SongRow {
                        track: track;
                        play => { Library.play(Library.open-key, track.key, false); }
                        open-artist(key) => { Nav.open-artist(key); }
                    }
                }
            }
        }
    }
}
