import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Library } from "library.slint";
import { Nav, Page } from "catalog.slint";
import { SearchView, ResultKind } from "search.slint";
import { Icons } from "components/icon.slint";
import { EmptyState } from "components/empty-state.slint";
import { Grid } from "components/grid.slint";
import { SearchField } from "components/search-field.slint";
import { SectionHeader } from "components/section-header.slint";
import { SongRow } from "components/song-row.slint";
import { Tile } from "components/tile.slint";

// Search: a field under the page title, then songs in columns and artists, albums and
// playlists as tiles, each with library matches first and Show More for the rest of
// Spotify's catalog.
export component SearchPage inherits VerticalLayout {
    padding-top: Theme.space-6;
    padding-left: Theme.space-7;
    padding-right: Theme.space-7;
    spacing: Theme.space-5;

    init => { field.focus(); }

    Text {
        height: Theme.pill-height;
        text: "Search";
        vertical-alignment: center;
        font-family: Theme.font-display;
        font-size: Theme.text-title;
        font-weight: Theme.weight-bold;
        letter-spacing: Theme.tracking-display;
        color: Theme.text;
    }

    HorizontalLayout {
        alignment: start;
        spacing: Theme.space-5;

        field := SearchField {
            width: Theme.field-width;
            text <=> SearchView.query;
            placeholder: "Songs, artists, albums and playlists";
            edited(text) => { SearchView.edited(text); }
            accepted(text) => { SearchView.accepted(text); }
        }

        Text {
            text: SearchView.status;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.text-small;
            color: Theme.text-tertiary;
        }
    }

    if SearchView.title != "": EmptyState {
        vertical-stretch: 1;
        padding-bottom: Theme.space-8;
        glyph: Icons.search;
        title: SearchView.title;
        message: SearchView.hint;
    }

    if SearchView.title == "": scroll := ScrollView {
        // New results start at the top.
        property <string> query: SearchView.query;
        changed query => { self.content-y = 0; }

        vertical-stretch: 1;
        content-width: self.visible-width;

        VerticalLayout {
            width: scroll.visible-width;
            padding-top: Theme.space-3;
            // Clear of the scroll bar, which overlays the content.
            padding-right: Theme.space-4;
            padding-bottom: Theme.space-7;
            spacing: Theme.space-7;

            if SearchView.songs.length > 0: VerticalLayout {
                spacing: Theme.space-3;

                SectionHeader {
                    title: "Songs";
                    action: SearchView.more-songs ? "Show More" : "";
                    clicked => { SearchView.more(ResultKind.songs); }
                }

                songs := Grid {
                    count: SearchView.songs.length;
                    min-cell: Theme.song-cell;
                    cell-height: Theme.row-height;
                    row-gap: 0;

                    for track[index] in SearchView.songs: SongRow {
                        x: songs.cell-x(index);
                        y: songs.cell-y(index);
                        width: songs.cell;
                        track: track;
                        play => { SearchView.play(track.key); }
                        open-artist(key) => { Nav.open-artist(key); }
                    }
                }
            }

            if SearchView.artists.length > 0: VerticalLayout {
                spacing: Theme.space-4;

                SectionHeader {
                    title: "Artists";
                    action: SearchView.more-artists ? "Show More" : "";
                    clicked => { SearchView.more(ResultKind.artists); }
                }

                artists := Grid {
                    count: SearchView.artists.length;

                    for artist[index] in SearchView.artists: Tile {
                        x: artists.cell-x(index);
                        y: artists.cell-y(index);
                        width: artists.cell;
                        title: artist.name;
                        detail: "Artist";
                        glyph: Icons.artist;
                        round: true;
                        clicked => { Nav.open-artist(artist.key); }
                    }
                }
            }

            if SearchView.albums.length > 0: VerticalLayout {
                spacing: Theme.space-4;

                SectionHeader {
                    title: "Albums";
                    action: SearchView.more-albums ? "Show More" : "";
                    clicked => { SearchView.more(ResultKind.albums); }
                }

                albums := Grid {
                    count: SearchView.albums.length;

                    for album[index] in SearchView.albums: Tile {
                        x: albums.cell-x(index);
                        y: albums.cell-y(index);
                        width: albums.cell;
                        title: album.name;
                        detail: album.year == "" ? album.artists : album.artists + " · " + album.year;
                        clicked => { Nav.open-album(album.key); }
                    }
                }
            }

            if SearchView.playlists.length > 0: VerticalLayout {
                spacing: Theme.space-4;

                SectionHeader {
                    title: "Playlists";
                    action: SearchView.more-playlists ? "Show More" : "";
                    clicked => { SearchView.more(ResultKind.playlists); }
                }

                playlists := Grid {
                    count: SearchView.playlists.length;

                    for playlist[index] in SearchView.playlists: Tile {
                        x: playlists.cell-x(index);
                        y: playlists.cell-y(index);
                        width: playlists.cell;
                        title: playlist.name;
                        detail: playlist.detail;
                        glyph: Icons.note;
                        clicked => {
                            Library.open(playlist.key);
                            Nav.go(Page.library);
                        }
                    }
                }
            }
        }
    }
}
