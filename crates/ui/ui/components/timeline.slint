import { Theme } from "../theme.slint";
import { Player, Format } from "../player.slint";
import { SeekBar } from "seek-bar.slint";

// Elapsed time, the seekable progress bar and length of the current track.
export component Timeline inherits HorizontalLayout {
    in property <length> thickness: Theme.seek-thickness;
    in property <length> font-size: Theme.text-caption;

    property <int> shown-ms: bar.dragging ? bar.drag-value * Player.duration-ms : Player.position-ms;

    spacing: Theme.space-2;

    Text {
        width: Theme.time-width;
        text: Format.clock(root.shown-ms);
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: root.font-size;
        color: Theme.text-tertiary;
    }

    bar := SeekBar {
        thickness: root.thickness;
        label: "Playback position";
        enabled: Player.has-track;
        value: Player.progress;
        committed(fraction) => { Player.seek(round(fraction * Player.duration-ms)); }
    }

    Text {
        width: Theme.time-width;
        text: Format.clock(Player.duration-ms);
        vertical-alignment: center;
        font-size: root.font-size;
        color: Theme.text-tertiary;
    }
}
