import { Theme } from "../theme.slint";
import { Icon, Icons } from "icon.slint";
import { IconButton } from "icon-button.slint";

// A capsule text field with an optional glyph, a placeholder while empty and a clear button
// while not. Its outline brightens while it has focus.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // The glyph before the text, or none when empty.
    in property <string> icon;
    // The text changed, by typing or by clearing.
    callback edited(string);
    // Enter was pressed.
    callback accepted(string);

    height: Theme.field-height;
    border-radius: self.height / 2;
    background: Theme.field;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.edge-focus : Theme.edge;
    animate border-color { duration: Theme.duration-fast; easing: ease-out; }
    forward-focus: input;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-1;
        spacing: Theme.space-3;

        if root.icon != "": VerticalLayout {
            alignment: center;

            Icon {
                commands: root.icon;
                width: Theme.icon-md;
                height: Theme.icon-md;
                fill: input.has-focus ? Theme.text : Theme.text-secondary;
                animate fill { duration: Theme.duration-fast; easing: ease-out; }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                vertical-alignment: center;
                overflow: elide;
                font-size: Theme.text-field;
                color: Theme.text-tertiary;
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                single-line: true;
                vertical-alignment: center;
                font-size: Theme.text-field;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                accessible-label: root.placeholder;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }

        if root.text != "": VerticalLayout {
            alignment: center;

            IconButton {
                icon: Icons.clear;
                label: "Clear";
                icon-size: Theme.icon-sm;
                clicked => {
                    root.text = "";
                    root.edited("");
                    input.focus();
                }
            }
        }
    }
}
