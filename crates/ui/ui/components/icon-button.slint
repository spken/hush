import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

// A round, borderless button showing one glyph.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> size: Theme.button-md;
    in property <length> icon-size: Theme.icon-md;
    in property <bool> enabled: true;
    in property <bool> selected;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: !root.enabled ? transparent : root.selected ? Theme.selected : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.duration-fast; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    Icon {
        commands: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        fill: root.enabled ? Theme.text : Theme.text-tertiary;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
