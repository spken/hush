import { Theme } from "../theme.slint";
import { Icons } from "icon.slint";
import { IconButton } from "icon-button.slint";
import { Player } from "../player.slint";

// Shuffle, previous, play/pause and next for the current track, with play/pause centred.
export component Transport inherits HorizontalLayout {
    alignment: center;
    spacing: Theme.space-3;

    HorizontalLayout {
        width: Theme.transport-side;
        alignment: end;
        spacing: Theme.space-3;

        IconButton {
            icon: Icons.shuffle;
            label: Player.shuffle ? "Turn Shuffle Off" : "Shuffle";
            size: Theme.button-sm;
            icon-size: Theme.icon-sm;
            enabled: Player.has-track;
            selected: Player.shuffle;
            tint: Player.shuffle ? Theme.text : Theme.text-secondary;
            clicked => { Player.set-shuffle(!Player.shuffle); }
        }

        IconButton {
            icon: Icons.previous;
            label: "Previous";
            size: Theme.button-sm;
            icon-size: Theme.icon-sm;
            enabled: Player.has-track;
            clicked => { Player.previous(); }
        }
    }

    IconButton {
        icon: Player.playing ? Icons.pause : Icons.play;
        label: Player.playing ? "Pause" : "Play";
        size: Theme.button-sm;
        icon-size: Theme.icon-sm;
        primary: true;
        enabled: Player.has-track;
        clicked => { Player.play-pause(); }
    }

    HorizontalLayout {
        width: Theme.transport-side;
        alignment: start;

        IconButton {
            icon: Icons.next;
            label: "Next";
            size: Theme.button-sm;
            icon-size: Theme.icon-sm;
            enabled: Player.has-track;
            clicked => { Player.next(); }
        }
    }
}
