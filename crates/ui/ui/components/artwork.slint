import { Theme } from "../theme.slint";
import { Icon, Icons } from "icon.slint";

// Square album art; a neutral placeholder until art is loaded.
export component Artwork inherits Rectangle {
    in property <length> size;
    in property <bool> large;

    width: root.size;
    height: root.size;
    border-radius: root.large ? Theme.radius-lg : Theme.radius-sm;
    background: Theme.art;

    Icon {
        commands: Icons.note;
        width: root.size * Theme.art-glyph-scale;
        height: self.width;
        fill: Theme.art-glyph;
    }
}
