import { Theme } from "../theme.slint";
import { Artwork } from "artwork.slint";
import { Icons } from "icon.slint";
import { IconButton } from "icon-button.slint";

// A list in the library: a small art block, its name and one line of detail. It is marked
// while open. A `pinnable` one shows a pin at its end while pinned or hovered.
export component ListEntry inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> glyph;
    in property <string> art;
    in property <bool> selected;
    in property <bool> pinnable;
    in property <bool> pinned;
    callback clicked();
    // Pins the list, or with `false` unpins it.
    callback pin(bool);

    height: Theme.row-height;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.selected : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.duration-fast; easing: ease-out; }
    accessible-role: list-item;
    accessible-label: root.title;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: root.pinnable ? Theme.button-sm + Theme.space-2 : Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;

            Artwork {
                size: Theme.art-row;
                glyph: root.glyph;
                art: root.art;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-1;

            Text {
                text: root.title;
                overflow: elide;
                font-size: Theme.text-body;
                font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
                color: Theme.text;
            }

            Text {
                text: root.detail;
                overflow: elide;
                font-size: Theme.text-small;
                color: Theme.text-secondary;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        // Inside the row's touch area, so hovering it keeps the row hovered.
        if root.pinnable: IconButton {
            x: parent.width - self.width - Theme.space-1;
            y: (parent.height - self.height) / 2;
            size: Theme.button-sm;
            icon: Icons.pin;
            icon-size: Theme.icon-sm;
            label: root.pinned ? "Unpin" : "Pin";
            tint: root.pinned ? Theme.text : Theme.text-secondary;
            opacity: root.pinned || touch.has-hover ? 1 : 0;
            animate opacity { duration: Theme.duration-fast; easing: ease-out; }
            clicked => { root.pin(!root.pinned); }
        }
    }
}
