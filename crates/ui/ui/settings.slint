// Settings state the Controller pushes to the UI, and the changes the UI sends back.

// Where updating Hush stands.
export enum UpdateState { idle, checking, latest, downloading, ready, failed }

export global SettingsView {
    // Hush's version, where updating it stands, and the version being installed.
    in property <string> version;
    in property <UpdateState> update;
    in property <string> available;
    // The Client ID of the user's Spotify app, for the Web API.
    in-out property <string> client-id;
    // The equalizer: on or off, a preamp and one gain per band, all in dB.
    in-out property <bool> eq;
    in-out property <float> preamp;
    in property <[float]> gains;
    // The band labels, by centre frequency.
    in property <[string]> bands;
    // The preset names, then "Custom"; `preset` is the one the gains match.
    in property <[string]> presets;
    in property <int> preset;
    in-out property <bool> normalisation;
    in-out property <bool> gapless;
    // Output device names, the system default first, and the IDs of the rest.
    in property <[string]> outputs: ["System Default"];
    in property <[string]> output-ids;
    in-out property <int> output;

    // Something above changed through the page.
    callback changed();
    callback client-id-edited(string);
    // A band's gain changed: its index and the gain in dB.
    callback set-gain(int, float);
    callback choose-preset(int);
    // Install the newest release, if it is newer.
    callback install-update();
    // Quit and start again, to run the installed release.
    callback restart();
}
