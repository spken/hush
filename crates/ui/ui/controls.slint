import { Theme } from "theme.slint";
import { Viewport } from "viewport.slint";
import { Timeline } from "components/timeline.slint";
import { Transport } from "components/transport.slint";
import { Volume } from "components/volume.slint";
import { DevicePicker } from "components/device-picker.slint";
import { TrackSummary } from "components/track-summary.slint";
import { IconButton } from "components/icon-button.slint";
import { Icons } from "components/icon.slint";
import { Queue } from "queue.slint";

// The borderless strip along the bottom of the canvas: the current track on the left,
// the transport over the timeline in the centre, volume and the device picker on the
// right, beside the queue button. The two sides are as wide as each other so the centre
// stays centred, and narrow with the window.
export component Controls inherits HorizontalLayout {
    property <length> side: Viewport.compact-bar ? Theme.summary-width-sm : Theme.summary-width;

    height: Theme.controls-height;
    padding-left: Viewport.compact-bar ? Theme.space-5 : Theme.space-6;
    padding-right: self.padding-left;
    spacing: Viewport.compact-bar ? Theme.space-4 : Theme.space-5;
    alignment: space-between;

    TrackSummary {
        width: root.side;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        preferred-width: Theme.player-width;
        alignment: center;
        spacing: Theme.space-1;

        Transport {}

        Timeline {
            font-size: Theme.text-small;
        }
    }

    HorizontalLayout {
        width: root.side;
        alignment: end;
        spacing: Theme.space-3;

        Volume {
            compact: Viewport.compact-bar;
        }

        HorizontalLayout {
            spacing: Theme.space-1;

            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: Icons.queue;
                    label: "Playing Next";
                    size: Theme.button-sm;
                    icon-size: Theme.icon-sm;
                    toggle: true;
                    on: Queue.open;
                    clicked => { Queue.set-open(!Queue.open); }
                }
            }

            DevicePicker {}
        }
    }
}
