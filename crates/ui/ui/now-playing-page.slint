import { Theme } from "theme.slint";
import { Player, Format, Connection } from "player.slint";
import { Icons } from "components/icon.slint";
import { EmptyState } from "components/empty-state.slint";
import { Grid } from "components/grid.slint";
import { SectionHeader } from "components/section-header.slint";
import { Tile } from "components/tile.slint";
import { Library, PlaylistRow } from "library.slint";
import { Nav, Page } from "catalog.slint";
import { Artwork } from "components/artwork.slint";
import { PillButton } from "components/pill-button.slint";

// The current track set like a poster: art as large as the page allows, an oversized
// title beside it. Without a track it says what to do instead.
export component NowPlayingPage {
    in property <bool> full-screen;
    callback toggle-full-screen();

    property <length> art-size: clamp(min(self.height - 2 * Theme.space-7, self.width * 0.45), Theme.art-min, Theme.art-max);

    if Player.has-track: HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        spacing: Theme.space-7;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Artwork {
                size: root.art-size;
                large: true;
                art: Player.art;
            }
        }

        VerticalLayout {
            alignment: center;

            VerticalLayout {
                height: root.art-size;
                max-width: Theme.poster-text-max;
                alignment: end;
                spacing: Theme.space-3;

                Text {
                    text: Player.title;
                    wrap: word-wrap;
                    font-family: Theme.font-display;
                    font-size: Theme.text-poster;
                    font-weight: Theme.weight-bold;
                    letter-spacing: Theme.tracking-display;
                    color: Theme.text;
                }

                Text {
                    text: Player.artists;
                    wrap: word-wrap;
                    font-family: Theme.font-display;
                    font-size: Theme.text-subtitle;
                    color: Theme.text-secondary;
                }

                Text {
                    text: Player.remote-device == "" ? Format.clock(Player.duration-ms)
                        : Format.clock(Player.duration-ms) + " · Playing on " + Player.remote-device;
                    font-size: Theme.text-body;
                    color: Theme.text-tertiary;
                }

                HorizontalLayout {
                    padding-top: Theme.space-5;
                    spacing: Theme.space-2;
                    alignment: start;

                    PillButton {
                        primary: true;
                        icon: Player.playing ? Icons.pause : Icons.play;
                        text: Player.playing ? "Pause" : "Play";
                        clicked => { Player.play-pause(); }
                    }

                    PillButton {
                        icon: root.full-screen ? Icons.collapse : Icons.expand;
                        text: root.full-screen ? "Exit Full Screen" : "Full Screen";
                        clicked => { root.toggle-full-screen(); }
                    }
                }
            }
        }
    }

    if !Player.has-track: VerticalLayout {
        padding-left: Theme.space-7;
        padding-right: Theme.space-7;
        padding-bottom: Theme.space-6;
        spacing: Theme.space-6;

        EmptyState {
            vertical-stretch: 1;
            glyph: Icons.note;
            glyph-color: Player.connection == Connection.failed ? Theme.danger : Theme.text-tertiary;
            title: Player.connection == Connection.connecting ? "Connecting to Spotify…"
                : Player.connection == Connection.failed ? "Couldn’t connect to Spotify"
                : "Nothing playing";
            message: Player.connection == Connection.connecting ? "Hush is signing in and registering as a Spotify Connect device."
                : Player.connection == Connection.failed ? Player.error + "\nRestart Hush to try again."
                : "Pick up a playlist where you left off, or choose Hush in Spotify’s device list on your phone or computer.";
        }

        // The playlists played last: one row of them, as many as fit.
        if Library.recent.length > 0: VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-4;

            SectionHeader {
                title: "Recently Played";
            }

            recent := Grid {
                count: min(Library.recent.length, self.columns);

                for index in recent.count: Tile {
                    property <PlaylistRow> playlist: Library.recent[index];

                    x: recent.cell-x(index);
                    y: recent.cell-y(index);
                    width: recent.cell;
                    art: self.playlist.art;
                    title: self.playlist.name;
                    detail: self.playlist.detail;
                    glyph: Icons.note;
                    playable: true;
                    clicked => {
                        Library.open(self.playlist.key);
                        Nav.go(Page.library);
                    }
                    play => { Library.play(self.playlist.key, 0, false); }
                }
            }
        }
    }
}
