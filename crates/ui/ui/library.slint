// Library state the Controller pushes to the UI, and the commands the UI sends back.

// A track in a list, as its row shows it.
export struct TrackRow {
    key: int,
    title: string,
    artists: string,
    // The first artist, or 0 when unknown.
    artist-key: int,
    duration: string,
    // Its album's cover, as `Art.image` reads it.
    art: string,
}

// An artist in a grid.
export struct ArtistRow {
    key: int,
    name: string,
    art: string,
}

// An album in a list or grid.
export struct AlbumRow {
    key: int,
    name: string,
    artists: string,
    // "" when unknown.
    year: string,
    // "Album", "Single" or "Compilation".
    kind: string,
    art: string,
}

// A playlist in the library list.
export struct PlaylistRow {
    key: int,
    name: string,
    detail: string,
    art: string,
}

export global Library {
    // The pinned playlists first, then the rest in the chosen order.
    in property <[PlaylistRow]> playlists;
    // How many of `playlists` are pinned.
    in property <int> pinned-count;
    // The names of the orders playlists can be in, and the index of the chosen one.
    in property <[string]> orders;
    in property <int> order;
    // The names of the orders the open list's songs can be in, and the index of the
    // chosen one.
    in property <[string]> track-orders;
    in property <int> track-order;
    // The playlists played last, most recent first.
    in property <[PlaylistRow]> recent;
    in property <string> liked-detail;
    // What the library page shows: 0 for Liked Songs, else the key of a playlist.
    in property <int> open-key;
    in property <string> open-title;
    in property <string> open-detail;
    // The open playlist's picture, or "".
    in property <string> open-art;
    // What to say while the open list is empty.
    in property <string> open-empty;
    in property <[TrackRow]> tracks;
    in property <bool> syncing;
    in property <string> sync-status;

    // Shows Liked Songs or a playlist, by `open-key`.
    callback open(int);
    // Orders the playlists by the order at this index of `orders`.
    callback sort(int);
    // Orders the open list's songs by the order at this index of `track-orders`.
    callback sort-tracks(int);
    // Pins the playlist with this key, or with `false` unpins it.
    callback pin(int, bool);
    // Plays the open list from the track with this key, or 0 for its top; shuffled or not.
    callback play(int, int, bool);
    callback sync();
}
