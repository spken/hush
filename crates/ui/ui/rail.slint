import { Theme } from "theme.slint";
import { Player, Connection } from "player.slint";
import { Icons } from "components/icon.slint";
import { IconButton } from "components/icon-button.slint";

export enum Page { now-playing, library }

// The slim navigation rail on the left edge, with the Spotify Connect status at its foot.
export component Rail inherits VerticalLayout {
    in-out property <Page> page;

    width: Theme.rail-width;
    padding-top: Theme.space-5;
    padding-bottom: Theme.space-5;
    spacing: Theme.space-3;

    HorizontalLayout {
        alignment: center;
        IconButton {
            icon: Icons.play;
            label: "Now Playing";
            size: Theme.button-md;
            icon-size: Theme.icon-sm;
            selected: root.page == Page.now-playing;
            clicked => { root.page = Page.now-playing; }
        }
    }

    HorizontalLayout {
        alignment: center;
        IconButton {
            icon: Icons.library;
            label: "Library";
            size: Theme.button-md;
            icon-size: Theme.icon-sm;
            selected: root.page == Page.library;
            clicked => { root.page = Page.library; }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }

    HorizontalLayout {
        alignment: center;
        accessible-role: text;
        accessible-label: Player.connection == Connection.ready ? "Connected to Spotify"
            : Player.connection == Connection.connecting ? "Connecting to Spotify"
            : "Not connected to Spotify";

        Rectangle {
            width: Theme.status-dot;
            height: Theme.status-dot;
            border-radius: self.width / 2;
            background: Player.connection == Connection.ready ? Theme.success
                : Player.connection == Connection.connecting ? Theme.warning
                : Theme.danger;
            animate background { duration: Theme.duration-normal; easing: ease-out; }
        }
    }
}
