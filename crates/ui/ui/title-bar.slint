import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { CaptionButton } from "components/caption-button.slint";

// The strip across the top of the frameless window: the logo above the rail, a middle that
// moves the window and maximizes it on double-click, and the window buttons.
export component TitleBar inherits Rectangle {
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximized();
    callback close();

    height: Theme.title-bar-height;

    WindowMoveArea {
        TouchArea {
            double-clicked => { root.toggle-maximized(); }
        }
    }

    HorizontalLayout {
        HorizontalLayout {
            width: Theme.rail-width;
            alignment: center;
            padding-top: (Theme.title-bar-height - Theme.icon-md) / 2;
            padding-bottom: self.padding-top;

            Image {
                source: @image-url("assets/hush.svg");
                width: Theme.icon-md;
                accessible-role: image;
                accessible-label: "Hush";
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        CaptionButton {
            icon: Icons.minimize;
            label: "Minimize";
            clicked => { root.minimize(); }
        }

        CaptionButton {
            icon: root.maximized ? Icons.restore : Icons.maximize;
            label: root.maximized ? "Restore" : "Maximize";
            clicked => { root.toggle-maximized(); }
        }

        CaptionButton {
            icon: Icons.close;
            label: "Close";
            close: true;
            clicked => { root.close(); }
        }
    }
}
