// State the Controller pushes to the UI, and the commands the UI sends back.

export enum Connection { connecting, ready, failed }

// A Spotify Connect device in the device picker.
export struct DeviceRow {
    id: string,
    name: string,
    // "This computer", or what kind of device it is.
    detail: string,
    active: bool,
}

export global Player {
    in property <Connection> connection;
    // What runs degraded, said in a sentence, or "".
    in property <string> notice;
    in property <string> error;
    in property <bool> has-track;
    in property <string> title;
    in property <string> artists;
    in property <int> duration-ms;
    // The track's album cover.
    in property <string> art;
    in property <int> position-ms;
    in property <bool> playing;
    in property <int> volume-max;
    in property <int> volume: self.volume-max / 2;
    out property <float> progress: self.duration-ms > 0 ? self.position-ms / self.duration-ms : 0;

    callback play-pause();
    callback next();
    callback previous();
    callback seek(int);
    callback set-volume(int);
    in property <bool> shuffle;
    callback set-shuffle(bool);
    // The name of the other device that plays, or "" while Hush does.
    in property <string> remote-device;
    in property <[DeviceRow]> devices;
    // Asks for the device list; `devices` fills when it arrives.
    callback list-devices();
    // Moves playback to the device with this ID.
    callback transfer(string);
    // Fires after `next-tick` while playing, to move `position-ms` on to the track's next
    // whole second; `tick` sets `next-tick` again each time.
    callback tick();
    in property <duration> next-tick: 1s;
}

export global Format {
    // A position in milliseconds as "m:ss".
    pure callback clock(int) -> string;
}

// Web API requests to one endpoint in the current minute.
export struct EndpointRequests {
    endpoint: string,
    requests: int,
}

// Something that happened to playback, and the local time it happened.
export struct Note {
    at: string,
    what: string,
}

export global Debug {
    // The device that plays: "Hush", another device's name, or "None".
    in property <string> playing-on: "–";
    // The latest playback notes, newest first.
    in property <[Note]> playback-notes;
    in property <string> private-bytes;
    in property <string> working-set;
    in property <int> web-api-requests;
    in property <string> cache-hit-rate: "–";
    in property <int> rate-limited;
    in property <int> quota-exceeded;
    in property <[EndpointRequests]> this-minute;
    // Asks for fresh memory figures.
    callback sample();
}
