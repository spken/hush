# Copy to .env. The Client ID is not a secret; never put a client secret here.
# Dashboard redirect URI: http://127.0.0.1:8898/callback
# The app reads its Client ID from Settings; only the examples read HUSH_CLIENT_ID.
HUSH_CLIENT_ID=
# Set to web-api to load album, artist and playlist pages from the Web API instead of
# Spotify's own metadata service (spclient).
HUSH_CATALOG=
